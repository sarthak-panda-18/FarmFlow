{
  "name": "farm-to-market-server",
  "version": "1.0.0",
  "description": "Backend API for Intelligent Farm-to-Market Decision & Buyer Recommendation Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "ml:start": "cd ../ml_service && .venv\\Scripts\\uvicorn main:app --host 0.0.0.0 --port 8000",
    "adb:reverse": "adb reverse tcp:5000 tcp:5000",
    "seed": "node src/scripts/seed.js",
    "import-dataset": "node src/scripts/importMarketPrices.js"
  },
  "keywords": [
    "farm-to-market",
    "agmarknet",
    "express",
    "mongodb",
    "flutter"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
